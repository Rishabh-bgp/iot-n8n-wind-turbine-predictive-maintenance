{
  "name": "Wind turbine condition monitoring (reference implementation)",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "turbine-telemetry", "responseMode": "lastNode", "options": {}},
      "id": "a1f0c0de-0001-4000-8000-000000000001", "name": "Telemetry Webhook",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "webhookId": "a1f0c0de-0001-4000-8000-0000000000aa"
    },
    {
      "parameters": {"jsCode": "const b = $input.first().json.body ?? $input.first().json;\nif (!b.turbine_id || !Array.isArray(b.readings)) { throw new Error('payload needs turbine_id and readings[]'); }\nconst clean = b.readings.filter(r => r.wind_speed >= 0 && r.wind_speed < 60);\nreturn [{ json: { turbine_id: b.turbine_id, readings: clean, vibration_rms: b.vibration_rms ?? 0, gearbox_temp: b.gearbox_temp ?? 60, power_residual: b.power_residual ?? 0 } }];"},
      "id": "a1f0c0de-0002-4000-8000-000000000002", "name": "Clean and Normalize",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [220, 0]
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.FORECAST_API_URL || 'http://localhost:8000' }}/forecast",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ turbine_id: $json.turbine_id, readings: $json.readings }) }}", "options": {}},
      "id": "a1f0c0de-0003-4000-8000-000000000003", "name": "Call Forecasting API",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0]
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.FORECAST_API_URL || 'http://localhost:8000' }}/health-score",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ turbine_id: $('Clean and Normalize').item.json.turbine_id, vibration_rms: $('Clean and Normalize').item.json.vibration_rms, gearbox_temp: $('Clean and Normalize').item.json.gearbox_temp, power_residual: $('Clean and Normalize').item.json.power_residual }) }}", "options": {}},
      "id": "a1f0c0de-0004-4000-8000-000000000004", "name": "Call Health Scoring API",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0]
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
        "conditions": [{"id": "c1", "leftValue": "={{ $json.anomaly }}", "rightValue": true,
          "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}},
      "id": "a1f0c0de-0005-4000-8000-000000000005", "name": "Anomaly Check",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 0]
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.MAINTENANCE_WEBHOOK_URL || 'http://localhost:5678/webhook/w2-approval' }}",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ turbine_id: $json.turbine_id, health_index: $json.health_index, action: $json.action, forecast: $('Call Forecasting API').item.json.wind_speed_forecast }) }}", "options": {}},
      "id": "a1f0c0de-0006-4000-8000-000000000006", "name": "Raise Maintenance Request (Workflow 2)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, -100]
    },
    {
      "parameters": {"jsCode": "return [{ json: { status: 'nominal', turbine_id: $json.turbine_id, health_index: $json.health_index, forecast: $('Call Forecasting API').item.json.wind_speed_forecast } }];"},
      "id": "a1f0c0de-0007-4000-8000-000000000007", "name": "Log Nominal State",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1100, 100]
    }
  ],
  "connections": {
    "Telemetry Webhook": {"main": [[{"node": "Clean and Normalize", "type": "main", "index": 0}]]},
    "Clean and Normalize": {"main": [[{"node": "Call Forecasting API", "type": "main", "index": 0}]]},
    "Call Forecasting API": {"main": [[{"node": "Call Health Scoring API", "type": "main", "index": 0}]]},
    "Call Health Scoring API": {"main": [[{"node": "Anomaly Check", "type": "main", "index": 0}]]},
    "Anomaly Check": {"main": [[{"node": "Raise Maintenance Request (Workflow 2)", "type": "main", "index": 0}],
                               [{"node": "Log Nominal State", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "pinData": {}
}
